---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { readdirSync } from 'fs';

// Read all files in the /public folder and filter for .jpeg images
const publicDir = './public';
const images = readdirSync(publicDir).filter(file => file.toLowerCase().endsWith('.jpeg'));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- Cache header for long-term caching of assets -->
		<meta http-equiv="Cache-Control" content="public, max-age=31536000" />
		<style>
			/* Responsive image gallery styling */
			.gallery {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
				padding: 1rem;
			}
			.gallery img {
				width: 100%;
				height: auto;
				object-fit: cover;
				border-radius: 8px;
			}
			@media (max-width: 720px) {
				.gallery {
					grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				}
			}
			main h1 {
				text-align: center;
				margin-top: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Image Gallery</h1>
			<div class="gallery">
				{images.map((image) => (
					<img src={`/${image}`} alt="Gallery image" loading="lazy" />
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
